<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Tsikhanau.Flow</PackageId>
    <Version>1.0.0</Version>
    <Authors>Stsiapan Tsikhanau</Authors>
    <Description>Workflow execution engine with step-by-step processing, error handling, and execution metadata</Description>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/stpntkhnv/Tsikhanau.Packages</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stpntkhnv/Tsikhanau.Packages</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>functional-programming;workflow;pipeline;flow;execution;csharp;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReleaseNotes>Initial release with workflow execution engine</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tsikhanau.Foundation\Tsikhanau.Foundation.csproj" />
    <ProjectReference Include="..\Tsikhanau.Monads\Tsikhanau.Monads.csproj" />
    <ProjectReference Include="..\Tsikhanau.RailwayExtensions\Tsikhanau.RailwayExtensions.csproj" />
  </ItemGroup>

</Project>
